# Oyama Hub Apache Rewrite Rules for REST API & Clean Admin URLs
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /Kyokushin-Karate/

    # Direct REST API Endpoints routing
    RewriteRule ^admin/katas(?:/([0-9]+))?$ admin/api/katas.php?id=$1 [QSA,L]
    RewriteRule ^admin/kihons(?:/([0-9]+))?$ admin/api/kihons.php?id=$1 [QSA,L]
    RewriteRule ^admin/users(?:/([0-9]+))?$ admin/api/users.php?id=$1 [QSA,L]
    RewriteRule ^admin/faixas(?:/([0-9]+))?$ admin/api/faixas.php?id=$1 [QSA,L]
    RewriteRule ^admin/exercicios(?:/([0-9]+))?$ admin/api/exercicios.php?id=$1 [QSA,L]
    RewriteRule ^admin/treinos(?:/([0-9]+))?$ admin/api/treinos.php?id=$1 [QSA,L]
    RewriteRule ^admin/progresso(?:/([0-9]+))?$ admin/api/progresso.php?id=$1 [QSA,L]
    RewriteRule ^admin/stats$ admin/api/stats.php [QSA,L]
</IfModule>

# ============================================================
# BLOQUEIO DE ARQUIVOS SENSIVEIS
# ============================================================
<FilesMatch "(?i)^(\.git|\.env|\.htpasswd|config\.php|PLANEJAMENTO\.md|Requisitos\.md|Projeto_Apresentacao\.md|\.vscode)$">
    Order Deny,Allow
    Deny from all
</FilesMatch>

<FilesMatch "(?i)\.(sql|docx|md|log|bak|swp|orig)$">
    Order Deny,Allow
    Deny from all
</FilesMatch>

# Bloquear acesso direto a diretorios sensiveis
<IfModule mod_rewrite.c>
    RewriteRule ^(\.git|database|sql)(/|$) - [F,L]
</IfModule>

# ============================================================
# HEADERS HTTP DE SEGURANCA
# ============================================================
<IfModule mod_headers.c>
    # Previne que o browser "adivinhe" o MIME type
    Header always set X-Content-Type-Options "nosniff"

    # Protege contra clickjacking (iframes externos nao podem embeds do site)
    Header always set X-Frame-Options "SAMEORIGIN"

    # Controla informacao de referencia enviada em requisicoes
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Desabilita permissoes desnecessarias para o browser
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=()"

    # Remover header que expoe o servidor
    Header always unset X-Powered-By
    Header always unset Server

    # CSP compativel com o projeto:
    # - fonts.googleapis.com / fonts.gstatic.com: fontes Google Fonts
    # - vlibras.gov.br: widget de acessibilidade VLibras
    # - youtube.com / youtube-nocookie.com: links/iframes de videos
    # - 'unsafe-inline': necessario para os estilos e scripts inline existentes no projeto
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://vlibras.gov.br https://fonts.googleapis.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self'; frame-src https://www.youtube.com https://www.youtube-nocookie.com; object-src 'none'; base-uri 'self'; form-action 'self';"
</IfModule>

# ============================================================
# COMPRESSAO GZIP
# ============================================================
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript
    AddOutputFilterByType DEFLATE application/javascript application/x-javascript application/json
    AddOutputFilterByType DEFLATE application/xml application/xhtml+xml application/rss+xml
    AddOutputFilterByType DEFLATE image/svg+xml
    AddOutputFilterByType DEFLATE font/truetype font/opentype application/vnd.ms-fontobject

    # Nao comprimir arquivos ja comprimidos
    SetEnvIfNoCase Request_URI \.(?:gif|jpe?g|png|webp|zip|gz|bz2|rar)$ no-gzip dont-vary
</IfModule>

# ============================================================
# CACHE DE RECURSOS ESTATICOS
# ============================================================
<IfModule mod_expires.c>
    ExpiresActive On

    # Imagens — cache de 1 mes
    ExpiresByType image/jpeg        "access plus 1 month"
    ExpiresByType image/jpg         "access plus 1 month"
    ExpiresByType image/png         "access plus 1 month"
    ExpiresByType image/gif         "access plus 1 month"
    ExpiresByType image/webp        "access plus 1 month"
    ExpiresByType image/svg+xml     "access plus 1 week"
    ExpiresByType image/x-icon      "access plus 1 year"
    ExpiresByType image/vnd.microsoft.icon "access plus 1 year"

    # CSS e JavaScript — cache de 1 semana
    ExpiresByType text/css          "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
    ExpiresByType text/javascript   "access plus 1 week"

    # Fontes — cache longo
    ExpiresByType font/woff         "access plus 1 year"
    ExpiresByType font/woff2        "access plus 1 year"
    ExpiresByType application/font-woff  "access plus 1 year"
    ExpiresByType application/vnd.ms-fontobject "access plus 1 year"

    # HTML e PHP — sem cache (dinamicos)
    ExpiresByType text/html         "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
    # Versioning: adicionar Cache-Control para ativos estaticos
    <FilesMatch "\.(css|js|png|jpg|jpeg|gif|webp|ico|svg|woff|woff2)$">
        Header append Cache-Control "public, must-revalidate"
    </FilesMatch>
</IfModule>
