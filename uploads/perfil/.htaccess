Options -Indexes -ExecCGI

<FilesMatch "(?i)\.(php\d*|phtml|phar|pl|py|rb|cgi|exe|sh|bash|htaccess|htpasswd)$">
    Require all denied
</FilesMatch>

<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>

<FilesMatch "(?i)\.(jpg|jpeg|png|webp)$">
    Header set X-Content-Type-Options "nosniff"
</FilesMatch>
